{
  "name": "@mir1198yusuf/pg-mcp",
  "version": "1.0.2",
  "description": "Minimal local MCP server for read-only PostgreSQL access via Claude Code. Supports multiple databases with a UI dashboard.",
  "type": "module",
  "bin": {
    "pg-mcp": "bin/pg-mcp.js"
  },
  "files": [
    "index.js",
    "ui.html",
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/pg-mcp.js"
  },
  "keywords": [
    "mcp",
    "postgresql",
    "postgres",
    "claude",
    "claude-code",
    "ai",
    "database",
    "local-mcp"
  ],
  "author": "mir1198yusuf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mir1198yusuf/pg-mcp.git"
  },
  "homepage": "https://github.com/mir1198yusuf/pg-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "pg": "^8.11.0",
    "zod": "^3.22.0"
  }
}
