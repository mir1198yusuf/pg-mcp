[
  {
    "_readme": "This is what ~/.pg-mcp/dbs.json looks like. Remove this _readme entry if you copy this file directly. Managed via the UI at http://localhost:3000/ui"
  },
  {
    "identifier": "main_app",
    "description": "Main app DB — users, orders, products",
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "password": "yourpassword",
    "db": "myapp",
    "ssl": false
  },
  {
    "identifier": "test_prep",
    "description": "Test prep platform DB — students, exams, results",
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "password": "yourpassword",
    "db": "test_prep_db",
    "ssl": false
  }
]
